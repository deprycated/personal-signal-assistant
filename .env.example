# First registration: native. Runtime: json-rpc-native.
SIGNAL_MODE=json-rpc-native
SIGNAL_HTTP_PORT=7070
ASSISTANT_HTTP_PORT=3010
SIGNAL_BOT_NUMBER=+48111111111
SIGNAL_OWNER_NUMBER=+48222222222
# Optional, recommended after first inbound message:
SIGNAL_OWNER_UUID=

# OpenRouter intent layer
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
ASSISTANT_TIMEZONE=Europe/Warsaw
